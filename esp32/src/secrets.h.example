// Copy this file to secrets.h and fill it in. secrets.h is git-ignored: NEVER commit it.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

#define MQTT_BROKER "your-broker.example.com"
#define MQTT_PORT 8883  // 8883 = MQTT over TLS
#define MQTT_USERNAME "gate-001"  // a broker account for THIS device only
#define MQTT_PASSWORD "device-mqtt-password"

#define DEVICE_ID "GATE-001"
// Printed once by:  cd backend && npm run register-device -- GATE-001
#define DEVICE_TOKEN "paste-the-device-token-here"

// 1 = encrypt the connection (strongly recommended, required for any real deployment).
#define MQTT_USE_TLS 1

// The root certificate that signed your broker's certificate, in PEM format (see esp32/README.md).
// Many hosted brokers use Let's Encrypt (ISRG Root X1); check yours.
static const char MQTT_CA_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
paste the broker's root CA certificate here
-----END CERTIFICATE-----
)EOF";

// DEVELOPMENT ONLY: accept any certificate. Leave this commented out for a real deployment,
// otherwise anyone able to intercept the connection could impersonate your broker.
// #define MQTT_ALLOW_INSECURE_TLS 1
