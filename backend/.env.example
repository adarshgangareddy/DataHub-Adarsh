# ---- Server -------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Browser origin(s) allowed to call this API (comma separated). Must be your real dashboard URL in production.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku/nginx). Needed for correct rate limiting.
TRUST_PROXY=0
# General API limit per client IP per minute (login and commands have stricter limits of their own).
API_RATE_LIMIT_PER_MIN=200

# ---- Authentication -----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8
# lax works when dashboard and API share a parent domain (or localhost). Use none only if they are on
# unrelated domains (requires https; some browsers block those cookies).
COOKIE_SAMESITE=lax
ADMIN_USERNAME=admin
# Generate with: npm run hash-password   (keep the single quotes; the hash contains $ characters)
ADMIN_PASSWORD_HASH=

# ---- Database (Supabase) ------------------------------------------------------------------
# supabase = real database. memory = development only, data is lost on restart.
DB_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- MQTT ---------------------------------------------------------------------------------
# e.g. mqtts://your-broker.example.com:8883
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=gate-control-backend
MQTT_TLS=true

# ---- Devices ------------------------------------------------------------------------------
# The device that is registered automatically at startup. More: npm run register-device
DEVICE_ID=GATE-001
# Mark a device OFFLINE after this many seconds without a heartbeat (device sends one every 30 s).
DEVICE_OFFLINE_TIMEOUT_S=120
# Mark OPEN/CLOSE/mode commands FAILED if the device does not acknowledge within this time.
COMMAND_ACK_TIMEOUT_S=15

# ---- Development mock (never in production) -----------------------------------------------
# true = a simulated ESP32 answers instead of a real one; no MQTT broker needed.
MOCK_DEVICE=false
MOCK_MOVE_SECONDS=4
MOCK_HEARTBEAT_SECONDS=10
